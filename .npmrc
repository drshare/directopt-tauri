# 本机（Dev Drive / 安全软件策略）禁止遍历符号链接（os error 448），
# pnpm 默认的 symlink 布局会导致 node_modules 内文件读取失败。
# 使用 npm 式扁平真实目录布局，绕开符号链接。
node-linker=hoisted
# 同时禁止从全局存储硬链接导入，改为直接复制文件
package-import-method=copy
# CI / 无 TTY 环境（如 GitHub Actions 的 Xcode Run Script 阶段）下，
# pnpm 需要移除 node_modules 重建时会因无法交互确认而中止
# （ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY），导致 iOS 等构建在 CI 中失败。
# 关闭移除确认提示，让 pnpm 在无 TTY 时也能自动重建依赖。
confirm-modules-purge=false
