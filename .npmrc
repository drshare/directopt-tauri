# pnpm v11 起，.npmrc 只用于读取 auth / registry 相关配置。
# 其余设置在 .npmrc 中会被静默忽略，必须改到 pnpm-workspace.yaml
# （或全局 ~/.config/pnpm/config.yaml）。
#
# 原在此处的 node-linker / package-import-method 已迁至 pnpm-workspace.yaml 的
# nodeLinker / packageImportMethod；下面两行**仅为兼容 pnpm v10 及更早版本**保留
# （v11 起此处会被忽略，真实生效值以 pnpm-workspace.yaml 为准，两者内容一致）。
node-linker=hoisted
package-import-method=copy
# 原 confirm-modules-purge 已删除：它不是 pnpm v11 的合法设置项（pnpm config set 会报
# ERR_PNPM_CONFIG_SET_UNSUPPORTED_YAML_CONFIG_KEY），其想解决的问题已由
# pnpm-workspace.yaml 的 verifyDepsBeforeRun: false 从源头规避。
#
# 若将来需要在此放置令牌，请使用 _authToken / //registry.npmjs.org/:_authToken 形式，
# 并注意不要把密钥提交进仓库。
